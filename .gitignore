# =============================================================================
# ExcaliMath — repository ignore rules
# =============================================================================
# Keep generated output, local dependencies, machine-specific settings, and
# secrets out of version control. Keep pnpm-lock.yaml files tracked so installs
# remain reproducible in local development and CI.

# -----------------------------------------------------------------------------
# Dependencies and package-manager state
# -----------------------------------------------------------------------------
# Installed packages are recreated from package manifests and lockfiles.
node_modules/
**/node_modules/

# pnpm's local store/link metadata is machine-specific; do NOT ignore
# pnpm-lock.yaml or pnpm-workspace.yaml.
.pnpm-store/
.pnpm-debug.log*

# Other package-manager artifacts in case a tool is run accidentally.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Build output and generated bundles
# -----------------------------------------------------------------------------
# Vite, TypeScript, Storybook, and common Node build output.
dist/
**/dist/
build/
**/build/
out/
**/out/

# Generated static Storybook site; Story sources and configuration stay tracked.
storybook-static/
**/storybook-static/

# TypeScript incremental/build metadata.
*.tsbuildinfo

# TypeScript build output accidentally emitted beside the Vite config.
/frontend/vite.config.js
/frontend/vite.config.d.ts

# Common framework or bundler caches.
.cache/
**/.cache/
.turbo/
**/.turbo/
.vite/
**/.vite/
.esbuild/
**/.esbuild/

# -----------------------------------------------------------------------------
# Test output and browser automation artifacts
# -----------------------------------------------------------------------------
# Playwright reports, traces, screenshots, and temporary run data.
/frontend/playwright-report/
/frontend/test-results/
/frontend/playwright/.cache/
**/playwright-report/
**/test-results/

# Coverage reports generated by test runners.
coverage/
**/coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Environment configuration and secrets
# -----------------------------------------------------------------------------
# Local environment files may contain Discord IDs, OAuth values, API keys,
# signing secrets, database URLs, or deployment credentials.
.env
.env.*
**/.env
**/.env.*

# Explicitly allow safe templates/documentation for required environment vars.
!.env.example
!.env.template
!**/.env.example
!**/.env.template

# Private keys, certificates, and credential stores.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore

# -----------------------------------------------------------------------------
# Logs, temporary files, and crash output
# -----------------------------------------------------------------------------
*.log
logs/
**/logs/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej
*.stackdump

# -----------------------------------------------------------------------------
# Operating-system and file-manager clutter
# -----------------------------------------------------------------------------
# macOS metadata and file browser state.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Windows thumbnails, metadata, and recycle-bin data.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux desktop metadata.
.directory
.Trash-*/

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
# VS Code personal workspace state and local configuration are ignored.
# Add an individually reviewed shared file later only if the team agrees it is safe.
.vscode/*
!.vscode/extensions.json

# JetBrains IDE workspace state.
.idea/

# Visual Studio user-specific state and generated folders.
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Vim and Emacs swap/backup files.
[._]*.sw[a-p]
*~
\#*\#

# -----------------------------------------------------------------------------
# Local databases, captures, and development data
# -----------------------------------------------------------------------------
# Ignore local-only database files and browser/media captures; keep migrations
# and deliberately checked-in fixtures tracked in their normal source folders.
*.sqlite
*.sqlite3
*.db
*.har
*.webm
*.mp4

# Local uploads, temporary storage, and runtime state, if introduced later.
/uploads/
/backend/uploads/
/backend/data/
/backend/.data/
/backend/*.pid
/backend/*.pid.lock

# -----------------------------------------------------------------------------
# Deployment and cloud-tool local state
# -----------------------------------------------------------------------------
# Terraform state may contain secrets. Keep Terraform source and lockfiles.
.terraform/
*.tfstate
*.tfstate.*

# Serverless/deployment tool output.
.serverless/
.vercel/
.netlify/

# -----------------------------------------------------------------------------
# Explicitly retained project files
# -----------------------------------------------------------------------------
# Do not add broad rules for package manifests, pnpm lockfiles, source maps,
# Markdown documentation, Storybook stories, Playwright tests, or CI workflows:
# these are project inputs and should remain reviewable and reproducible.
