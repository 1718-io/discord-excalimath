# Public Discord Application Client ID (safe to expose in the frontend bundle).
# Copy this file to .env.local and replace the placeholder before Activity testing.
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id

# Optional WebSocket room service endpoint.
# Local standalone development defaults to ws://127.0.0.1:8080.
# Production Discord Activities should use a public wss:// endpoint and map
# its origin through the Activity URL mappings in the Developer Portal.
VITE_ROOM_SERVER_URL=ws://127.0.0.1:8080
